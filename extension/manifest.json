{
  "manifest_version": 3,
  "name": "Crunchyroll Remote Controller",
  "version": "1.1.0",
  "description": "Control Crunchyroll video playback from your mobile phone via local WebSocket.",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.crunchyroll.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.crunchyroll.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
